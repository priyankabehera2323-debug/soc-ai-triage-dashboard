# Copy to /etc/wazuh-airia-forwarder.env, fill in real values, then:
#   sudo chown root:root /etc/wazuh-airia-forwarder.env
#   sudo chmod 0600 /etc/wazuh-airia-forwarder.env
# Never commit a filled-in version of this file.

AIRIA_API_URL=<AIRIA_AGENT_EXECUTION_URL>
AIRIA_API_KEY=<AIRIA_API_KEY>
LOCAL_API_KEY=<HELPER_API_KEY>
LOCAL_API_HEADER=X-API-Key

WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
ANALYSES_FILE=/var/lib/wazuh-airia-forwarder/analyses.jsonl
STATE_FILE=/var/lib/wazuh-airia-forwarder/state.json

BIND_HOST=<LAB_HOST_IP>
BIND_PORT=8010
REQUEST_TIMEOUT_SECONDS=120

FORWARD_EXISTING_ON_FIRST_START=false
INCLUDE_FILE_DIFF=false
LOG_LEVEL=INFO
