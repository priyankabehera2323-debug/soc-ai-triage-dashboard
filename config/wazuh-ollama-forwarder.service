[Unit]
Description=Wazuh FIM scoring and summary service
After=network-online.target wazuh-manager.service
Wants=network-online.target

[Service]
Type=simple
User=wazuh-forwarder
Group=wazuh-forwarder
SupplementaryGroups=wazuh
EnvironmentFile=/etc/wazuh-ollama-forwarder.env
ExecStart=/opt/wazuh-ollama-forwarder/venv/bin/python /opt/wazuh-ollama-forwarder/wazuh_ollama_forwarder.py
WorkingDirectory=/opt/wazuh-ollama-forwarder
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/ossec/logs/alerts
ReadWritePaths=/var/lib/wazuh-ollama-forwarder
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
