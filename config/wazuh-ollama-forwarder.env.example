# Copy to /etc/wazuh-ollama-forwarder.env, then:
#   sudo chown root:root /etc/wazuh-ollama-forwarder.env
#   sudo chmod 0600 /etc/wazuh-ollama-forwarder.env
# Never commit a filled-in copy: it contains the API key.
# Generate a key with:  openssl rand -hex 32

# --- required ---
LOCAL_API_KEY=<HELPER_API_KEY>
LOCAL_API_HEADER=X-API-Key

# --- local LLM summaries (off by default: the VM has little free RAM) ---
LLM_ENABLED=false
# LLM_URL=http://127.0.0.1:11434/api/chat
# LLM_MODEL=qwen3:0.6b
# LLM_TIMEOUT_SECONDS=240
# LLM_MIN_AVAILABLE_MB=900
# LLM_MAX_PER_MINUTE=3

# --- scoring ---
# Paths under these folders are capped at Low (comma-separated, lowercase, forward slashes)
# LOW_RISK_PATHS=c:/soc-lab/fim-test/

# --- tailing and API ---
FORWARD_EXISTING_ON_FIRST_START=false
# WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
# ANALYSES_FILE=/var/lib/wazuh-ollama-forwarder/analyses.jsonl
# STATE_FILE=/var/lib/wazuh-ollama-forwarder/state.json
# BIND_HOST=127.0.0.1
# BIND_PORT=8010
